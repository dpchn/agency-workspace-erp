# Copy to .env (next to docker-compose.yml) and edit. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
# Full reference: docs/CONFIGURATION.md

# ---- Production domain (used by docker-compose.prod.yml only)
DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com

# ---- Secrets: CHANGE ALL of these before going live.
# Sign-in token key, at least 32 characters.
JWT_SECRET=change-me-use-openssl-rand-base64-48-at-least-32-bytes
# Database passwords. They are applied only when the database volume is first created.
POSTGRES_PASSWORD=change-me-postgres-superuser
DB_OWNER_PASSWORD=change-me-migrations-role
DB_APP_PASSWORD=change-me-runtime-role

# ---- Behaviour
# false = agencies can only be created by you (see docs/DEPLOYMENT.md, "Platform admin")
SIGNUP_ENABLED=true
TRIAL_DAYS=30
# ---- App sign-in by mobile number + SMS code (OTP)
# log  = codes are only written to the backend log (development)
# http = your SMS gateway; {phone}, {otp} and {message} are filled in. Example (MSG91/Fast2SMS-style GET):
#        SMS_HTTP_URL=https://sms.example.com/send?apikey=XXXX&to=91{phone}&text={message}
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
# Optional header for the gateway, "Name: value"
SMS_HTTP_AUTH_HEADER=
# How long an app sign-in lasts (days). Leaving the agency or deactivation still ends it immediately.
MOBILE_TOKEN_DAYS=30
# NEVER true in production: returns the code in the API response (local testing only)
OTP_DEV_ECHO=false

# Your own login for the platform console (/platform): onboard agencies, plans, suspend/restore.
# Created (or flagged as platform admin) when the backend starts. Leave empty to skip.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# How long a sign-in lasts, in minutes
ACCESS_TOKEN_MINUTES=720
# Background jobs: day close (no-shows), incident escalation, overdue invoices, notifications
JOBS_ENABLED=true
# * is safe (bearer tokens, no cookies); or restrict, e.g. https://erp.example.com
CORS_ORIGINS=*
TZ=Asia/Kolkata

# ---- Branding: product name shown before login. Each agency can set its own after login.
BRAND_NAME=DutyGrid
BRAND_TAGLINE="Workforce ERP for security & facility agencies"
BRAND_PRIMARY="#1d4ed8"
BRAND_SUPPORT_EMAIL=support@example.com
