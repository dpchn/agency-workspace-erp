# Where the Next.js server proxies /v1/* (read at build time). Only port 3000 needs to be exposed.
BACKEND_URL=http://localhost:8080
# Optional: make the browser call the API directly instead of via the proxy (needs CORS_ORIGINS on the backend)
NEXT_PUBLIC_API_URL=
# Product branding (white-label). Tenants can override colour/logo/name in Settings -> Branding.
NEXT_PUBLIC_BRAND_NAME=DutyGrid
NEXT_PUBLIC_BRAND_TAGLINE=Workforce ERP for security & facility agencies
NEXT_PUBLIC_BRAND_PRIMARY=#1d4ed8
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
